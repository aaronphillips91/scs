{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment / Module System
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Output
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Strictness (important for your system)
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,

    // Modern TS behavior
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    // Interop / Quality
    "skipLibCheck": true,

    "ignoreDeprecations": "6.0"
  },

  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
